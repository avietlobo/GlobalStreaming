# Redirect everything to the 'public' folder except if it's already in 'public'
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ /public/$1 [L]

# If the request is for a file or directory that exists and is not a video file, don't rewrite
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !\.(mp4|mov|avi)$ [NC] # Add video file extensions here
RewriteRule ^ - [L]

# Rewrite all other requests to the 'public/index.php' file
RewriteRule ^(.*)$ /public/index.php [L]